# agent-voice-input credential environment template
# Default location: ~/.config/agent-voice-input/agent-voice-input.env (chmod 600 recommended)
# Also falls back to ~/.config/voice-input/voice-input.env or process environment variables
# Naming rule: canonical vendor name preferred (<VENDOR>_API_KEY); prefix aliases (API_KEY_<VENDOR>) also supported
# Tip: in your real .env file, keep only the credentials you actually use and remove/comment out unused placeholders.

# 1. Alibaba Cloud Bailian / DashScope (provider = "dashscope", default auto Stage 1: qwen3-asr-flash; Stage 2: qwen-turbo-latest)
DASHSCOPE_API_KEY="<your-dashscope-api-key>"
# Supported aliases: ALI_API_KEY / API_KEY_ALI

# 2. Volcengine Doubao Speech (provider = "doubao", Stage 1 ASR: bigmodel; supports APP_ID + API_KEY or single API_KEY)
DOUBAO_ASR_APP_ID="<your-volcengine-speech-app-id>"
DOUBAO_ASR_API_KEY="<your-volcengine-speech-access-token>"
# Supported aliases: APP_ID_DOUBAO_ASR / API_KEY_DOUBAO_ASR

# 3. Volcengine Ark (provider = "volcengine", Stage 2 Refiner: doubao-seed-1-6-flash)
ARK_API_KEY="<your-volcengine-ark-api-key>"
# Supported aliases: VOLCENGINE_API_KEY / HUOSHAN_API_KEY / API_KEY_HUOSHAN

# 4. OpenRouter (provider = "openrouter", supports both Stage 1 dual-protocol ASR & Stage 2 Refiner with one key)
OPENROUTER_API_KEY="<your-openrouter-api-key>"
# Supported alias: API_KEY_OPENROUTER

# 5. Google Gemini (provider = "gemini", native single-hop Stage 1 ASR or Stage 2 Refiner)
GEMINI_API_KEY="<your-gemini-api-key>"
# Supported alias: API_KEY_GEMINI

# 6. OpenAI (provider = "openai" or "openai-compatible")
OPENAI_API_KEY="<your-openai-api-key>"
# Supported alias: API_KEY_OPENAI

# 7. Groq Cloud (provider = "groq", fast Whisper STT & Stage 2 Refiner)
GROQ_API_KEY="<your-groq-api-key>"
# Supported alias: API_KEY_GROQ

# 8. SiliconFlow (provider = "siliconflow", SenseVoiceSmall STT & Stage 2 Refiner)
SILICONFLOW_API_KEY="<your-siliconflow-api-key>"
# Supported alias: API_KEY_SILICONFLOW

# Optional runtime config overrides (CLI flags > AGENT_VOICE_INPUT_* > config.toml):
# AGENT_VOICE_INPUT_ASR_PROVIDER="openrouter"
# AGENT_VOICE_INPUT_ASR_MODEL="qwen/qwen3-asr-1.7b"
# AGENT_VOICE_INPUT_ASR_API="auto"
# AGENT_VOICE_INPUT_ASR_EFFORT="auto"
# AGENT_VOICE_INPUT_REFINER_PROVIDER="openrouter"
# AGENT_VOICE_INPUT_REFINER_MODEL="google/gemini-2.5-flash-lite"
# AGENT_VOICE_INPUT_REFINER_EFFORT="low"
