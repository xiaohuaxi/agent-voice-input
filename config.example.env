# agent-voice-input credential environment template
# Default location: ~/.config/agent-voice-input/agent-voice-input.env (chmod 600 recommended)
# Also falls back to ~/.config/voice-input/voice-input.env or process environment variables
# Naming rule: suffix style preferred (<VENDOR>_API_KEY); prefix aliases (API_KEY_<VENDOR>) also supported

# 1. Alibaba Cloud Bailian / DashScope (default Stage 1 provider: qwen3-asr-flash)
ALI_API_KEY="<your-dashscope-api-key>"
# Supported aliases: API_KEY_ALI / DASHSCOPE_API_KEY

# 2. Volcengine Doubao Speech (optional Stage 1 provider; requires both APP_ID and API_KEY)
DOUBAO_ASR_APP_ID="<your-volcengine-speech-app-id>"
DOUBAO_ASR_API_KEY="<your-volcengine-speech-access-token>"
# Supported aliases: APP_ID_DOUBAO_ASR / API_KEY_DOUBAO_ASR

# 3. Volcengine Ark (used when refiner.provider = "openai-compatible" points to volces.com)
HUOSHAN_API_KEY="<your-volcengine-ark-api-key>"
# Supported aliases: API_KEY_HUOSHAN / ARK_API_KEY

# 4. Google Gemini (used when asr.provider = "gemini" for single-hop audio + context transcription)
GEMINI_API_KEY="<your-gemini-api-key>"

# 5. OpenAI or OpenAI-compatible endpoints (used when asr/refiner uses openai-compatible)
OPENAI_API_KEY="<your-openai-api-key>"
