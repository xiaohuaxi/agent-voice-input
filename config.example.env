# agent-voice-input credential environment template
# Default location: ~/.agent-voice-input/.env (chmod 600 recommended; override root via AGENT_VOICE_INPUT_HOME)
# Process environment variables take precedence over values in .env
# Naming rule: canonical vendor name preferred (<VENDOR>_API_KEY); prefix aliases (API_KEY_<VENDOR>) also supported
# Tip: uncomment the line(s) you use by removing the leading '#', replace the placeholder with your real key,
# and keep unused lines commented out.

# === Stage 1: Speech Recognition (REQUIRED for cloud ASR — uncomment 1 key below; local loopback openai-compatible ASR needs no key) ===
# Simplest 1-Key Quick Start (each key below drives both Stage 1 ASR and Stage 2 Refiner out of the box):
#   Mainland China: DASHSCOPE_API_KEY or DEEPSEEK_API_KEY
#   Global:         OPENAI_API_KEY or GEMINI_API_KEY

# 1. Alibaba Cloud Bailian / DashScope [Mainland China] (Stage 1 qwen3-asr-flash + Stage 2 qwen3.8-flash, or single-hop qwen3.8-omni-flash)
# DASHSCOPE_API_KEY="<your-dashscope-api-key>"
# Supported aliases: ALI_API_KEY / API_KEY_ALI

# 2. DeepSeek Official API [Mainland China] (single key for Stage 1 deepseek-asr + Stage 2 deepseek-flash)
# DEEPSEEK_API_KEY="<your-deepseek-api-key>"
# Supported alias: API_KEY_DEEPSEEK

# 3. OpenAI [Global] (Stage 1 gpt-transcribe or single-hop gpt-audio-1.5/gpt-audio-mini + Stage 2 gpt-6-luna)
# OPENAI_API_KEY="<your-openai-api-key>"
# Supported alias: API_KEY_OPENAI

# 4. Google Gemini [Global] (native single-hop Stage 1 audio + context refinement, or Stage 2 Refiner)
# GEMINI_API_KEY="<your-gemini-api-key>"
# Supported alias: API_KEY_GEMINI

# --- Other Supported Stage 1 Providers & Legacy Credentials ---

# 5. Volcengine Doubao Speech (provider = "doubao", Stage 1 ASR: bigmodel; single-header X-Api-Key, no APP_ID needed)
# DOUBAO_SPEECH_API_KEY="<your-volcengine-speech-api-key>"
# Legacy dual-header app credentials (optional; still supported when DOUBAO_SPEECH_API_KEY is unset):
# DOUBAO_ASR_APP_ID="<your-volcengine-speech-app-id>"
# DOUBAO_ASR_API_KEY="<your-volcengine-speech-access-token>"
# Legacy prefix aliases: APP_ID_DOUBAO_ASR / API_KEY_DOUBAO_ASR

# 6. Groq Cloud (provider = "groq", fast Stage 1 Whisper STT & Stage 2 Refiner)
# GROQ_API_KEY="<your-groq-api-key>"
# Supported alias: API_KEY_GROQ

# 7. OpenRouter (provider = "openrouter", Stage 1 microsoft/mai-transcribe-2 + Stage 2 google/gemini-3.8-flash)
# OPENROUTER_API_KEY="<your-openrouter-api-key>"
# Supported alias: API_KEY_OPENROUTER

# 8. SiliconFlow (provider = "siliconflow", Stage 1 SenseVoiceSmall STT & Stage 2 Refiner)
# SILICONFLOW_API_KEY="<your-siliconflow-api-key>"
# Supported alias: API_KEY_SILICONFLOW

# === Stage 2 Only: Optional Refiner (pair with a Stage 1 key above) ===
# Note: Setting ONLY a Stage 2 key below cannot transcribe speech on its own.
# Local Codex CLI login (`codex login`, auto-detected) or Antigravity CLI (`refiner.provider = "agy"`)
# can also reuse your existing CLI login for Stage 2 refinement when paired with Stage 1 ASR
# (billing depends on your CLI auth mode, e.g., subscription login vs. API key).

# 9. Volcengine Ark (provider = "volcengine", Stage 2 Refiner: doubao-seed-2-0-mini-260428)
# ARK_API_KEY="<your-volcengine-ark-api-key>"
# Supported aliases: VOLCENGINE_API_KEY / HUOSHAN_API_KEY / API_KEY_HUOSHAN

# Non-secret options (providers, models, hotkeys, HUD, audio, retries, etc.) belong in ~/.agent-voice-input/config.toml.
# Proxy (optional): HTTPS_PROXY / HTTP_PROXY / NO_PROXY can be exported in your shell or set here (shell env takes precedence; HTTP/HTTPS proxies only, SOCKS5 not supported).
