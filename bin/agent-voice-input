#!/usr/bin/env python3
"""Lightweight zero-install CLI wrapper for agent-voice-input."""
import os
import sys

if sys.version_info < (3, 10):
    _ver = "{0}.{1}.{2}".format(
        sys.version_info[0], sys.version_info[1], sys.version_info[2]
    )
    sys.stderr.write(
        "agent-voice-input requires Python 3.10+ (found {0} at {1}).\n"
        "Fix: install Python 3.10+ (macOS: 'brew install python'), "
        "or install with uv (auto-manages Python): 'uv tool install agent-voice-input'.\n".format(
            _ver, sys.executable
        )
    )
    raise SystemExit(1)

_SRC_DIR = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "src")
if os.path.isdir(_SRC_DIR) and _SRC_DIR not in sys.path:
    sys.path.insert(0, _SRC_DIR)

from agent_voice_input.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
